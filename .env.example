# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
#
#   cp .env.example .env
#
# Values here are safe placeholders for local development only. Every one of them is
# regenerated for staging and production and set in the hosting provider's dashboard.

# --- Environment ---------------------------------------------------------------------
# One of: local | ci | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Postgres (consumed by docker-compose) -------------------------------------------
POSTGRES_USER=careergraph
POSTGRES_PASSWORD=careergraph_local_dev_only
POSTGRES_DB=careergraph

# Host-side ports. Deliberately NOT the defaults: a natively installed PostgreSQL or Redis
# usually already owns 5432/6379, and the resulting collision produces a misleading
# "password authentication failed" instead of an obvious port error.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# --- Database URLs (consumed by the application) -------------------------------------
# Host `localhost` and the host-side port above, because these are used when running pytest or
# the API directly on your machine. Inside docker-compose the host is the service name `db` on
# port 5432, which compose sets itself.
DATABASE_URL=postgresql+asyncpg://careergraph:careergraph_local_dev_only@localhost:5433/careergraph
TEST_DATABASE_URL=postgresql+asyncpg://careergraph:careergraph_local_dev_only@localhost:5433/careergraph_test

# --- Redis / background jobs ---------------------------------------------------------
REDIS_URL=redis://localhost:6380/0

# Celery broker. Defaults to REDIS_URL when unset; set it separately only if the queue and
# the cache should live on different instances.
# CELERY_BROKER_URL=

# One worker process: the free hosting instance shares 512 MB with the API, and each extra
# child is a full Python interpreter.
CELERY_CONCURRENCY=1
# Recycle a worker child after this many tasks, so a slow leak in a parsing library cannot
# accumulate into an out-of-memory kill.
CELERY_MAX_TASKS_PER_CHILD=10

# --- Uploads ---------------------------------------------------------------------------
# 5 MB. Resumes are a page or two; an unbounded upload is a trivial way to exhaust memory.
MAX_UPLOAD_BYTES=5242880

# --- HTTP ----------------------------------------------------------------------------
# Comma-separated allowlist of browser origins permitted to call this API.
CORS_ORIGINS=http://localhost:3000

# --- Authentication ------------------------------------------------------------------
# The signing key for access tokens. Anyone holding it can forge a token for any account.
#
# The value below is a KNOWN PLACEHOLDER, published in this repository, and the application
# refuses to start with it when ENVIRONMENT is staging or production. Generate a real one:
#
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
#
JWT_SECRET_KEY=dev-only-insecure-secret-change-me-in-production

# Access tokens are short-lived because a JWT cannot be revoked before it expires — its
# lifetime is exactly the window a stolen one stays useful.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
